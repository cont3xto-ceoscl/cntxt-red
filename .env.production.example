# ==============================================================================
# CNTXT R.E.D. System — Variables de Entorno para Producción (Hostinger VPS)
# Copiar este archivo como .env en el servidor: cp .env.production.example .env
# ==============================================================================

# Seguridad Django
SECRET_KEY=cambiar-por-una-clave-secreta-fuerte-y-aleatoria-de-64-caracteres
DEBUG=False
ALLOWED_HOSTS=red.cntxt.co,localhost,127.0.0.1

# Base de Datos PostgreSQL
DB_NAME=cntxt_red_db
DB_USER=cntxt_red_user
DB_PASSWORD=ContraseñaSeguraPostgres2026!
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info

# JWT Settings (Opcionales - Usan valores por defecto en settings.py)
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# Slack Integration (Opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#notificaciones-red
